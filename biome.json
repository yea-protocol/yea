{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "ts/src/**",
      "ts/test/**",
      "ts/scripts/**",
      "ts/*.ts",
      "mcp/src/**",
      "mcp/test/**",
      "connectors/*/src/**",
      "connectors/*/test/**",
      "examples/**",
      "bench/**",
      "deploy/demo/src/**",
      "scripts/**",
      "site/scripts/**",
      "site/.vitepress/*.ts",
      "site/.vitepress/theme/*.ts",
      "site/.vitepress/theme/components/Playground.vue",
      "site/.vitepress/theme/components/playground/*.ts",
      "site/.vitepress/theme/components/playground/*.vue",
      "!**/*.json",
      "!**/*.jsonc",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "skipBlankLines": true
          }
        },
        "useMaxParams": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noImportCycles": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["site/.vitepress/theme/**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "ts/test/**",
        "mcp/test/**",
        "connectors/*/test/**",
        "bench/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "ts/src/**",
        "examples/**",
        "deploy/**",
        "scripts/**",
        "site/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "off"
          }
        }
      }
    }
  ]
}
