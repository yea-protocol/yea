{
  "name": "@yea-protocol/mcp",
  "version": "0.1.0",
  "description": "YEA job tools for the TypeScript MCP SDK: previews, typed approval, a signed policy, consent codes and undo. Also the bridge behind `yea mcp`.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./test-drive": {
      "types": "./dist/test-drive.d.ts",
      "default": "./dist/test-drive.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./http/node": {
      "types": "./dist/http-node.d.ts",
      "default": "./dist/http-node.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.100.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@yea-protocol/sdk": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^22.20.5",
    "@yea-protocol/sdk": "0.1.0",
    "typescript": "^7.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "model-context-protocol",
    "approval",
    "consent",
    "undo",
    "tool-use"
  ],
  "author": "James Solomon",
  "homepage": "https://yea-protocol.github.io/yea/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yea-protocol/yea.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/yea-protocol/yea/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
