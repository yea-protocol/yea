{
  "name": "yea-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "ts",
    "cli",
    "examples",
    "bench",
    "site",
    "deploy/demo"
  ],
  "scripts": {
    "build": "npm run build -w @yea-protocol/sdk",
    "test": "npm test -w @yea-protocol/sdk",
    "demo": "npm run build && node examples/demo.ts",
    "bench": "npm run build && node bench/run.ts && node bench/estimator.ts",
    "site": "npm run build -w yea-site",
    "lint": "biome check .",
    "lint:style": "oxlint --config .oxlintrc.json ts/src ts/test ts/scripts examples bench deploy/demo/src scripts site/scripts site/.vitepress/config.ts site/.vitepress/theme/index.ts",
    "lint:style:fix": "npm run lint:style -- --fix",
    "format": "biome format --write .",
    "prepare": "lefthook install || true"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@stylistic/eslint-plugin": "5.10.0",
    "lefthook": "2.1.14",
    "oxlint": "1.85.0"
  }
}
